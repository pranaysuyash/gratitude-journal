{
  "name": "gratitude-journal-mobile",
  "version": "1.0.0",
  "description": "Complete cross-platform gratitude journal app",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "expo start --web",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace GratitudeJournal.xcworkspace -scheme GratitudeJournal -configuration Release",
    "deploy:android": "cd android && ./gradlew bundleRelease",
    "deploy:ios": "cd ios && fastlane deploy"
  },
  "dependencies": {
